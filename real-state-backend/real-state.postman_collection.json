						"description": "Propósito: autenticar a un usuario y devolver access_token + refresh_token.\n\nParámetros requeridos:\n- username: string requerido\n- password: string requerido\n\nHeaders recomendados:\n- Content-Type: application/json\n- X-Device-Fingerprint: identificador estable del dispositivo\n\nPayload exitoso:\n{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}\n\nRespuestas esperadas:\n- 200 OK: autenticación exitosa, devuelve tokens y datos del usuario\n- 400 Bad Request: JSON inválido o campos vacíos\n- 401 Unauthorized: credenciales inválidas o sesión no válida"
					},
					"response": []
				},
				{
					"name": "POST /v1/refresh",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status code is 200\", function () {\n  pm.response.to.have.status(200);\n});",
									"pm.test(\"Refresh returns valid token\", function () {\n  const json = pm.response.json();\n  pm.expect(json.access_token).to.be.a('string');\n  pm.expect(json.token_type).to.eql('Bearer');\n  pm.environment.set('bearer_token', json.access_token);\n});"
								]
							}
						}

		{
			"name": "Sync & Monitoring",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"type": "text/javascript",
						"exec": [
							"const deviceFingerprint = pm.environment.get('device_fingerprint') || 'mobile-device-123';",
							"pm.environment.set('device_fingerprint', deviceFingerprint);",
							"if (!pm.environment.get('bearer_token')) {",
							"  const baseUrl = (pm.environment.get('base_url') || 'http://localhost:8080').replace(/\\/$/, '');",
							"  const username = pm.environment.get('username') || 'admin';",
							"  const password = pm.environment.get('password') || 'admin123';",
							"  pm.sendRequest({",
							"    url: baseUrl + '/v1/login',",
							"    method: 'POST',",
							"    header: { 'Content-Type': 'application/json', 'X-Device-Fingerprint': deviceFingerprint },",
							"    body: { mode: 'raw', raw: JSON.stringify({ username, password }) }",
							"  }, function (err, response) {",
							"    if (err) { throw new Error('Auto-login failed: ' + err.message); }",
							"    if (response.code !== 200) { throw new Error('Auto-login failed with status ' + response.code); }",
							"    const json = response.json();",
							"    const accessToken = json.data && json.data.authentication && json.data.authentication.access_token;",
							"    const refreshToken = json.data && json.data.authentication && json.data.authentication.refresh_token;",
							"    if (!accessToken || !refreshToken) { throw new Error('Auto-login response is missing tokens'); }",
							"    pm.environment.set('bearer_token', accessToken);",
							"    pm.environment.set('refresh_token', refreshToken);",
							"  });",
							"}",
							"if (!pm.environment.get('bearer_token')) { throw new Error('No bearer token available'); }",
							"pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + pm.environment.get('bearer_token') });",
							"pm.request.headers.upsert({ key: 'X-Device-Fingerprint', value: deviceFingerprint });"
						]
					}
				}
			],

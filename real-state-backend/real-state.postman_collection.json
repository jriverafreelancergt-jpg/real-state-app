					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status code is 200\", function () {\n  pm.response.to.have.status(200);\n});",
									"pm.test(\"Response has success status\", function () {\n  const json = pm.response.json();\n  pm.expect(json.status).to.eql('success');\n  pm.expect(json.data.authentication.access_token).to.be.a('string');\n  pm.expect(json.data.authentication.refresh_token).to.be.a('string');\n  pm.environment.set('bearer_token', json.data.authentication.access_token);\n  pm.environment.set('refresh_token', json.data.authentication.refresh_token);\n});"
								]
							}
						}
					],
